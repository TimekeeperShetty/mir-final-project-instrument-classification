{
  "experiment": {
    "name": "slakh_to_openmic",
    "train_domain": "synthetic",
    "eval_domain": "real",
    "run_test_after_fit": true
  },
  "trainer": {
    "seed": 42,
    "accelerator": "gpu",
    "devices": "auto",
    "strategy": "auto",
    "precision": "bf16-mixed",
    "max_epochs": 15,
    "log_every_n_steps": 20,
    "gradient_clip_val": 1.0,
    "accumulate_grad_batches": 1,
    "num_sanity_val_steps": 0,
    "save_dir": "runs"
  },
  "optimizer": {
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "data": {
    "task_type": "multilabel",
    "num_classes": 20,
    "sample_rate": 48000,
    "clip_duration_sec": 5.0,
    "threshold": 0.5,
    "label_names": [
      "accordion",
      "banjo",
      "bass",
      "cello",
      "clarinet",
      "cymbals",
      "drums",
      "flute",
      "guitar",
      "mallet",
      "mandolin",
      "organ",
      "piano",
      "saxophone",
      "synth",
      "trombone",
      "trumpet",
      "ukulele",
      "violin",
      "voice"
    ],
    "loader": {
      "batch_size": 16,
      "num_workers": 8,
      "pin_memory": true,
      "persistent_workers": true,
      "drop_last": true
    },
    "train": {
      "type": "slakh",
      "domain": "synthetic",
      "input_kind": "waveform",
      "params": {},
      "augmentations": {}
    },
    "val": {
      "type": "openmic",
      "domain": "real",
      "input_kind": "waveform",
      "params": {},
      "loader": {
        "drop_last": false
      }
    },
    "test": {
      "type": "openmic",
      "domain": "real",
      "input_kind": "waveform",
      "params": {},
      "loader": {
        "drop_last": false
      }
    }
  },
  "encoder": {
    "type": "external",
    "input_kind": "waveform",
    "output_dim": 512,
    "freeze": true,
    "factory": "your_project.encoders:build_clap_encoder",
    "factory_kwargs": {
      "pretrained_name": "replace_me"
    }
  },
  "classifier": {
    "type": "linear",
    "hidden_dim": 512,
    "dropout": 0.0
  }
}
