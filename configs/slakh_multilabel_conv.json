{
  "experiment": {
    "name": "slakh_openmic_overlap_conv",
    "train_domain": "synthetic",
    "eval_domain": "synthetic",
    "run_test_after_fit": true
  },
  "trainer": {
    "seed": 42,
    "accelerator": "auto",
    "devices": "auto",
    "strategy": "auto",
    "precision": "32-true",
    "max_epochs": 15,
    "log_every_n_steps": 20,
    "gradient_clip_val": 1.0,
    "accumulate_grad_batches": 1,
    "num_sanity_val_steps": 0,
    "save_dir": "runs"
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "scheduler": "cosine"
  },
  "logging": {
    "wandb": {
      "enabled": false,
      "project": "mir-instrument-classification",
      "entity": null,
      "name": "slakh_openmic_overlap_conv",
      "mode": null,
      "tags": [
        "slakh",
        "multilabel",
        "openmic-overlap"
      ],
      "log_model": false
    },
    "val_demos": {
      "enabled": true,
      "count": 4,
      "seed": 42,
      "every_n_epochs": 1
    }
  },
  "data": {
    "task_type": "multilabel",
    "num_classes": 20,
    "sample_rate": 22050,
    "clip_duration_sec": 5.0,
    "threshold": 0.5,
    "label_names": [
      "accordion",
      "banjo",
      "bass",
      "cello",
      "clarinet",
      "cymbals",
      "drums",
      "flute",
      "guitar",
      "mallet_percussion",
      "mandolin",
      "organ",
      "piano",
      "saxophone",
      "synthesizer",
      "trombone",
      "trumpet",
      "ukulele",
      "violin",
      "voice"
    ],
    "loader": {
      "batch_size": 16,
      "num_workers": 4,
      "pin_memory": true,
      "persistent_workers": true,
      "drop_last": true
    },
    "train": {
      "type": "slakh",
      "domain": "synthetic",
      "input_kind": "waveform",
      "params": {
        "root": "/projects/work/marl/datasets/mir_datasets/slakh/slakh2100_flac_redux",
        "split": "train"
      }
    },
    "val": {
      "type": "slakh",
      "domain": "synthetic",
      "input_kind": "waveform",
      "params": {
        "root": "/projects/work/marl/datasets/mir_datasets/slakh/slakh2100_flac_redux",
        "split": "vallidation"
      },
      "loader": {
        "drop_last": false
      }
    },
    "test": {
      "type": "slakh",
      "domain": "synthetic",
      "input_kind": "waveform",
      "params": {
        "root": "/projects/work/marl/datasets/mir_datasets/slakh/slakh2100_flac_redux",
        "split": "test"
      },
      "loader": {
        "drop_last": false
      }
    }
  },
  "encoder": {
    "type": "conv_waveform",
    "input_kind": "waveform",
    "output_dim": 128
  },
  "classifier": {
    "type": "mlp",
    "hidden_dim": 256,
    "dropout": 0.1
  }
}
